@QueueApi_HostAddress = http://localhost:5087
@ProfileApi_HostAddress = http://localhost:5104
@organizationId = 11111111-1111-1111-1111-111111111111
@userId = 22222222-2222-2222-2222-222222222222
@staffUserId = 33333333-3333-3333-3333-333333333333

### Create the organization in ProfileApi first
POST {{ProfileApi_HostAddress}}/api/organizations
Content-Type: application/json

{
  "name": "Heilbronn University"
}

### Create the visitor in ProfileApi
# ProfileApi stores roles as numbers: 0 Visitor, 1 Staff, 2 Admin.
POST {{ProfileApi_HostAddress}}/api/userprofiles
Content-Type: application/json

{
  "id": "{{userId}}",
  "fullName": "Alex Visitor",
  "email": "alex.visitor@example.com",
  "role": 0
}

### Create the staff user in ProfileApi
POST {{ProfileApi_HostAddress}}/api/userprofiles
Content-Type: application/json

{
  "id": "{{staffUserId}}",
  "fullName": "Sam Staff",
  "email": "sam.staff@example.com",
  "role": 1
}

@queueId = 
@counterId = 
@assignmentId = 
@ticketId = 

### Ticket statuses
GET {{QueueApi_HostAddress}}/api/ticket-statuses
Accept: application/json

### Create queue
# Paste the organization id returned by ProfileApi into organizationId above.
POST {{QueueApi_HostAddress}}/api/queues
Content-Type: application/json

{
  "organizationId": "{{organizationId}}",
  "name": "Student Registrar",
  "description": "Enrollment and documents",
  "ticketPrefix": "REG"
}

### List queues
GET {{QueueApi_HostAddress}}/api/queues?organizationId={{organizationId}}
Accept: application/json

### Open queue
PATCH {{QueueApi_HostAddress}}/api/queues/{{queueId}}/open
Content-Type: application/json

{
  "isOpen": true
}

### Create counter
POST {{QueueApi_HostAddress}}/api/queues/{{queueId}}/counters
Content-Type: application/json

{
  "name": "Counter 1"
}

### Open counter
PATCH {{QueueApi_HostAddress}}/api/counters/{{counterId}}/open
Content-Type: application/json

{
  "isOpen": true
}

### Assign staff
POST {{QueueApi_HostAddress}}/api/counters/{{counterId}}/assignments
Content-Type: application/json

{
  "staffUserId": "{{staffUserId}}"
}

### Join queue
POST {{QueueApi_HostAddress}}/api/queues/{{queueId}}/tickets
Content-Type: application/json

{
  "userId": "{{userId}}"
}

### Ticket position
GET {{QueueApi_HostAddress}}/api/tickets/{{ticketId}}/position
Accept: application/json

### Call next ticket
POST {{QueueApi_HostAddress}}/api/counters/{{counterId}}/tickets/call-next
Accept: application/json

### Start service
PATCH {{QueueApi_HostAddress}}/api/tickets/{{ticketId}}/start

### Complete ticket
PATCH {{QueueApi_HostAddress}}/api/tickets/{{ticketId}}/complete

### Daily counters
GET {{QueueApi_HostAddress}}/api/queues/{{queueId}}/daily-counters
Accept: application/json

###
